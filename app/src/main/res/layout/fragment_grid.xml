<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/n3_bg"
    android:orientation="vertical">

    <!-- Steuerleiste: Gruppierung (Tag/Monat/Jahr/Alle) und Spalten pro Zeile -->
    <HorizontalScrollView
        android:id="@+id/controlBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/n3_bg"
        android:scrollbars="none"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="10dp"
            android:paddingEnd="10dp"
            android:paddingTop="2dp"
            android:paddingBottom="6dp">

            <com.google.android.material.chip.ChipGroup
                android:id="@+id/groupChips"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:selectionRequired="true"
                app:singleLine="true"
                app:singleSelection="true">

                <com.google.android.material.chip.Chip
                    android:id="@+id/chipDay"
                    style="@style/Widget.Material3.Chip.Filter"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:checkable="true"
                    android:text="@string/group_day" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/chipMonth"
                    style="@style/Widget.Material3.Chip.Filter"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:checkable="true"
                    android:text="@string/group_month" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/chipYear"
                    style="@style/Widget.Material3.Chip.Filter"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:checkable="true"
                    android:text="@string/group_year" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/chipAll"
                    style="@style/Widget.Material3.Chip.Filter"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:checkable="true"
                    android:text="@string/group_all" />
            </com.google.android.material.chip.ChipGroup>

            <View
                android:id="@+id/colsDivider"
                android:layout_width="1dp"
                android:layout_height="22dp"
                android:layout_marginStart="10dp"
                android:layout_marginEnd="10dp"
                android:background="@color/n3_divider" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnColsMinus"
                style="@style/Widget.Material3.Button.TonalButton"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:contentDescription="@string/grid_fewer"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:minWidth="0dp"
                android:paddingLeft="0dp"
                android:paddingRight="0dp"
                android:text="−"
                android:textSize="18sp" />

            <TextView
                android:id="@+id/tvCols"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:layout_marginStart="6dp"
                android:layout_marginEnd="6dp"
                android:minWidth="76dp"
                android:textColor="@color/n3_on_bg"
                android:textSize="12sp"
                tools:text="4 Spalten" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnColsPlus"
                style="@style/Widget.Material3.Button.TonalButton"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:contentDescription="@string/grid_more"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:minWidth="0dp"
                android:paddingLeft="0dp"
                android:paddingRight="0dp"
                android:text="+"
                android:textSize="18sp" />
        </LinearLayout>
    </HorizontalScrollView>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <com.n3vibecode.gallery.widget.ZoomGridRecyclerView
            android:id="@+id/recycler"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:paddingBottom="24dp"
            android:scrollbars="vertical" />

        <LinearLayout
            android:id="@+id/emptyView"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:gravity="center"
            android:orientation="vertical"
            android:paddingStart="32dp"
            android:paddingEnd="32dp"
            android:visibility="gone">

            <ImageView
                android:layout_width="56dp"
                android:layout_height="56dp"
                android:alpha="0.45"
                android:contentDescription="@null"
                android:src="@drawable/ic_image"
                android:tint="@color/n3_on_surface_variant" />

            <TextView
                android:id="@+id/emptyTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="@string/empty"
                android:textColor="@color/n3_on_bg"
                android:textSize="17sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/emptySub"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:gravity="center"
                android:text="@string/empty_hint"
                android:textColor="@color/n3_on_surface_variant"
                android:textSize="13sp" />
        </LinearLayout>

        <!-- Einmaliger Hinweis beim ersten Start: so zoomt man raus -->
        <TextView
            android:id="@+id/tvPinchHint"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom|center_horizontal"
            android:layout_marginBottom="18dp"
            android:background="@drawable/bg_pinch_label"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:paddingTop="8dp"
            android:paddingBottom="8dp"
            android:text="@string/pinch_hint"
            android:textColor="#FFFFFFFF"
            android:textSize="12sp"
            android:visibility="gone"
            tools:ignore="RtlSymmetry" />

        <!-- Einblendung während des Zoomens: "6 Spalten" -->
        <TextView
            android:id="@+id/tvPinchLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:background="@drawable/bg_pinch_label"
            android:paddingStart="18dp"
            android:paddingEnd="18dp"
            android:paddingTop="10dp"
            android:paddingBottom="10dp"
            android:textColor="#FFFFFFFF"
            android:textSize="16sp"
            android:textStyle="bold"
            android:visibility="gone"
            tools:text="6 Spalten" />
    </FrameLayout>
</LinearLayout>
