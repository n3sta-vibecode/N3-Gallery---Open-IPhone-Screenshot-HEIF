<?xml version="1.0" encoding="utf-8"?>
<com.n3vibecode.gallery.widget.SquareFrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:padding="1dp">

    <ImageView
        android:id="@+id/image"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/n3_surface_variant"
        android:contentDescription="@null"
        android:scaleType="centerCrop" />

    <TextView
        android:id="@+id/badge"
        style="@style/N3Badge"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|start"
        android:layout_margin="4dp"
        android:visibility="gone" />

    <ImageView
        android:id="@+id/iconOverlay"
        android:layout_width="22dp"
        android:layout_height="22dp"
        android:layout_gravity="bottom|end"
        android:layout_margin="4dp"
        android:alpha="0.9"
        android:contentDescription="@null"
        android:visibility="gone" />

    <ImageView
        android:id="@+id/fav"
        android:layout_width="16dp"
        android:layout_height="16dp"
        android:layout_gravity="top|end"
        android:layout_margin="4dp"
        android:contentDescription="@null"
        android:src="@drawable/ic_heart_filled"
        android:visibility="gone" />

    <View
        android:id="@+id/videoBar"
        android:layout_width="3dp"
        android:layout_height="34dp"
        android:layout_gravity="top|start"
        android:layout_marginStart="3dp"
        android:layout_marginTop="6dp"
        android:background="@color/n3_accent"
        android:visibility="gone" />

    <ProgressBar
        android:id="@+id/progress"
        android:layout_width="22dp"
        android:layout_height="22dp"
        android:layout_gravity="center"
        android:indeterminateTint="@color/n3_accent"
        android:visibility="gone" />
</com.n3vibecode.gallery.widget.SquareFrameLayout>
