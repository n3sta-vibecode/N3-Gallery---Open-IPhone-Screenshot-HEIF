<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">
    <style name="Theme.N3Gallery" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="colorPrimary">@color/n3_accent</item>
        <item name="colorOnPrimary">#FFFFFFFF</item>
        <item name="colorPrimaryContainer">@color/n3_accent_dark</item>
        <item name="colorOnPrimaryContainer">#FFFFFFFF</item>
        <item name="colorSurface">@color/n3_surface</item>
        <item name="colorOnSurface">@color/n3_on_bg</item>
        <item name="colorSurfaceVariant">@color/n3_surface_variant</item>
        <item name="colorOnSurfaceVariant">@color/n3_on_surface_variant</item>
        <item name="android:colorBackground">@color/n3_bg</item>
        <item name="colorOnBackground">@color/n3_on_bg</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar" tools:targetApi="m">true</item>
        <item name="materialAlertDialogTheme">@style/Theme.N3Gallery.Dialog</item>
    </style>

    <style name="Theme.N3Gallery.Detail" parent="Theme.N3Gallery">
        <item name="android:colorBackground">#FF000000</item>
        <item name="colorSurface">#FF14141A</item>
        <item name="android:windowLightStatusBar" tools:targetApi="m">false</item>
    </style>

    <style name="Theme.N3Gallery.Dialog" parent="ThemeOverlay.Material3.MaterialAlertDialog">
        <item name="colorPrimary">@color/n3_accent</item>
    </style>

    <style name="N3Badge">
        <item name="android:background">@drawable/bg_badge</item>
        <item name="android:textColor">#FFFFFFFF</item>
        <item name="android:textSize">9sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:paddingStart">4dp</item>
        <item name="android:paddingEnd">4dp</item>
        <item name="android:paddingTop">2dp</item>
        <item name="android:paddingBottom">2dp</item>
        <item name="android:letterSpacing">0.04</item>
        <item name="android:maxLines">1</item>
    </style>

    <style name="N3SectionTitle">
        <item name="android:textColor">@color/n3_accent</item>
        <item name="android:textSize">13sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:letterSpacing">0.08</item>
        <item name="android:paddingTop">18dp</item>
        <item name="android:paddingBottom">6dp</item>
    </style>

    <style name="N3MetaLabel">
        <item name="android:textColor">@color/n3_on_surface_variant</item>
        <item name="android:textSize">13sp</item>
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_weight">0.42</item>
    </style>

    <style name="N3MetaValue">
        <item name="android:textColor">@color/n3_on_bg</item>
        <item name="android:textSize">13sp</item>
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_weight">0.58</item>
        <item name="android:textIsSelectable">true</item>
    </style>
</resources>
